# ----------------------------------------------------------------------------
# StickyNotes project-specific (T010 / quickstart.md §Avoiding committing
# secrets). Constitution VI/VIII: never commit app sandbox container data,
# derived data, local credential/env files, or anything containing note
# content / file paths / secrets.
# ----------------------------------------------------------------------------

# Derived data (Xcode / SwiftPM)
DerivedData/
build/
# Xcode explicit precompiled module cache (generated inside the xcodeproj)
*.xcodeproj/-Xcc/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# SwiftPM local build artifacts (already partly covered above; explicit repeat)
.build/
.build.swiftpm/
*.xctest
Packages/*/Package.resolved
!Packages/StickyCore/Package.resolved
# (Package.resolved at the workspace root IS committed to pin deps; the
#  above exception preserves the StickyCore one if it lives at the package
#  root. The xcodeproj-level Package.resolved is also committed.)

# App sandbox container (NEVER commit — may contain real note content/DB/
# assets). Lives under ~/Library/Containers/<bundle-id>/; the pattern below
# is a defensive catch for accidental copies.
local.stickynotes.app/

# Local credential / env files (NEVER commit real credentials)
.env
.env.*
*.local.env
secrets/
*.key
*.pem
*.p12
*.mobileprovision

# Sync test fixtures that may contain real provider URLs/credentials
# (deterministic local test servers / mocks ARE committed; real-service
# configs are NOT).
local-sync-config.json
webdav-local.json
s3-local.json

# Diagnostics bundles exported by the app (may contain sanitized logs but
# still not source-controlled).
*.diagnosticsbundle
Diagnostics/

# Prototypes scratch directory (T025a Milestone 0 prototypes live here; not
# part of the shipping app/package).
Prototypes/*/

# macOS Keychain export files (defensive)
*.keychain
*.keychain-db

# Xcode generated source files (defensive — should not be committed)
*.generated.swift


# Opencode image
.opencode/images

# Zcode
.zcode/
# Local git worktrees (skill: using-git-worktrees)
.worktrees/
