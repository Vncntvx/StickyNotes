      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs automatically a few seconds after changes, and at the interval you choose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容变更几秒后自动同步，并按所选间隔定期同步。"
          }
        }
      }
    },
    "Automatic sync starts once the vault is unlocked on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic sync starts once the vault is unlocked on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险库在这台 Mac 上解锁后才会开始自动同步。"
          }
        }
      }
    },
    "Keep sync unlocked on this Mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep sync unlocked on this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上保持同步解锁"
          }
        }
      }
    },
    "Sync will stay unlocked on this Mac until it restarts or you lock the vault.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync will stay unlocked on this Mac until it restarts or you lock the vault."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步将保持解锁，直到这台 Mac 重启或你锁定保险库。"
          }
        }
      }
    },
    "The remembered unlock was cleared.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remembered unlock was cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已清除记忆的解锁状态。"
          }
        }
      }
    },
    "Keeps the vault unlocked across app relaunches until this Mac restarts or you lock the vault.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the vault unlocked across app relaunches until this Mac restarts or you lock the vault."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用重启后保持保险库解锁，直到这台 Mac 重启或你锁定保险库。"
          }
        }
      }
    },
    "Saves the vault key securely in Keychain. It's cleared when you restart or lock the vault.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the vault key securely in Keychain. It's cleared when you restart or lock the vault."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险库密钥安全存储在钥匙串中；重启或锁定保险库后会清除。"
          }
        }
      }
    },
