    "When enabled, changes sync automatically a few seconds after editing. You can also choose a periodic interval.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, changes sync automatically a few seconds after editing. You can also choose a periodic interval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，编辑内容几秒后自动同步；也可以选择定期同步间隔。"
          }
        }
      }
    },
    "Applies to all notes. Chinese text uses a matching system font when needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to all notes. Chinese text uses a matching system font when needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用于所有笔记；中文会在需要时使用匹配的系统字体。"
          }
        }
      }
    },
    "There is no password recovery. If you forget your sync password, your encrypted sync data can't be recovered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no password recovery. If you forget your sync password, your encrypted sync data can't be recovered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有密码找回机制。如果忘记同步密码，加密的同步数据将无法恢复。"
          }
        }
      }
    },
    "Type a font family name — for example, Helvetica Neue.": {
