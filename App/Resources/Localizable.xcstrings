    "permission.accessibility.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Used only by an advanced window-identification feature; ordinary screenshot capture does not need it."
