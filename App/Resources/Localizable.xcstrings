    "permission.screen-recording.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticky Notes needs Screen Recording permission to capture screenshots. Your notes remain fully usable without it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便利贴需要屏幕录制权限才能截屏。未授权时便签功能仍可正常使用。"
          }
        }
      }
    },
