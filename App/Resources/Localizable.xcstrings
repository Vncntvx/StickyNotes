    "Sticky Notes Help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticky Notes Help"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便利贴帮助"
          }
        }
      }
    },
    "Menu-bar first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu-bar first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏优先"
          }
        }
      }
    },
    "Sticky Notes lives in the menu bar. Click the note icon to open your library; click it again to dismiss. The library is your home for creating, searching, and organizing notes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticky Notes lives in the menu bar. Click the note icon to open your library; click it again to dismiss. The library is your home for creating, searching, and organizing notes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便利贴常驻菜单栏。点击便签图标打开资料库，再次点击关闭。资料库是创建、搜索和整理便笺的地方。"
          }
        }
      }
    },
    "Auto-save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动保存"
          }
        }
      }
    },
    "Notes save automatically as you type — there is no Save button. Close a note window and reopen it later; your content is preserved. A note you never wrote anything into is removed automatically when its window closes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes save automatically as you type — there is no Save button. Close a note window and reopen it later; your content is preserved. A note you never wrote anything into is removed automatically when its window closes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便笺随输入自动保存——没有“保存”按钮。关闭便笺窗口后重新打开，内容仍会保留。从未写过任何内容的便笺会在窗口关闭时自动移除。"
          }
        }
      }
    },
    "Keyboard shortcuts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard shortcuts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘快捷键"
          }
        }
      }
    },
    "⌘N — new note\n⌘W — close note window\n⌘Q — quit Sticky Notes\n⌘F — search your notes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘N — new note\n⌘W — close note window\n⌘Q — quit Sticky Notes\n⌘F — search your notes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘N — 新建便笺\n⌘W — 关闭便笺窗口\n⌘Q — 退出便利贴\n⌘F — 搜索便笺"
          }
        }
      }
    },
    "Markdown shortcuts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown shortcuts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown 快捷输入"
          }
        }
      }
    },
    "Type “# ” for a heading, “- ” for a bullet, “- [ ] ” for a todo, “**text**” for bold, “*text*” for italic, and three backticks for a code block. A single Undo (⌘Z) restores the exact Markdown you typed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type “# ” for a heading, “- ” for a bullet, “- [ ] ” for a todo, “**text**” for bold, “*text*” for italic, and three backticks for a code block. A single Undo (⌘Z) restores the exact Markdown you typed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入“# ”创建标题、“- ”创建列表、“- [ ] ”创建待办、“**文字**”加粗、“*文字*”斜体，三个反引号创建代码块。按一次撤销（⌘Z）即可恢复原始 Markdown 语法。"
          }
        }
      }
    },
    "Search": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索"
          }
        }
      }
    },
    "Search matches titles, note text, todo items, code blocks, file names, and screenshot captions. Use the sort menu to switch between Recently Modified, Created, Title, and Manual order.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search matches titles, note text, todo items, code blocks, file names, and screenshot captions. Use the sort menu to switch between Recently Modified, Created, Title, and Manual order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索可匹配标题、正文、待办、代码块、文件名和截图说明。使用排序菜单可在最近修改、创建时间、标题和手动排序之间切换。"
          }
        }
      }
    },
    "Screenshots and files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots and files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图与文件"
          }
        }
      }
    },
    "Add a screenshot or a file reference from a note's upper control area. Files are referenced, never copied. A screenshot viewer opens in its own window with zoom and caption editing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a screenshot or a file reference from a note's upper control area. Files are referenced, never copied. A screenshot viewer opens in its own window with zoom and caption editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在便笺上方控制区可添加截图或文件引用。文件以引用方式关联，不会复制。截图查看器会在独立窗口中打开，支持缩放和说明编辑。"
          }
        }
      }
    },
    "Synchronization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步"
          }
        }
      }
    },
    "Synchronization is optional and end-to-end encrypted. Configure exactly one WebDAV or S3-compatible repository in Settings. Your notes are encrypted on this Mac before upload; forgetting your sync password makes encrypted remote data unrecoverable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization is optional and end-to-end encrypted. Configure exactly one WebDAV or S3-compatible repository in Settings. Your notes are encrypted on this Mac before upload; forgetting your sync password makes encrypted remote data unrecoverable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步为可选功能，采用端到端加密。可在设置中配置一个 WebDAV 或 S3 兼容仓库。便笺在上传前会在本机加密；忘记同步密码将导致加密远程数据无法恢复。"
          }
        }
      }
    },
    "Not configured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not configured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置"
          }
        }
      }
    },
    "Configured": {
      "extractionState": "manual",
      "localizations": {
