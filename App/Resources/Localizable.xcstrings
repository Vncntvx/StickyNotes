    "sync.unrecoverable-password": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync password is unrecoverable. If you forget it, your synced data cannot be recovered — even by the developer or your provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步密码无法找回。如果您忘记密码，将无法恢复已同步的数据——开发者或服务商均无法恢复。"
          }
        }
      }
    },
